{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ptrgiang/trustforge-skills/contracts/commitmentguard-contract.schema.json",
  "title": "TrustForge CommitmentGuard contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commitments"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "commitments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "required": {"type": "boolean", "default": true},
          "evidence": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "equals": {},
              "gte": {},
              "lte": {},
              "truthy": {"const": true},
              "contains": {},
              "max_age_seconds": {"type": "number", "minimum": 0},
              "allowed_source_kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {"required": ["equals"]},
              {"required": ["gte"]},
              {"required": ["lte"]},
              {"required": ["truthy"]},
              {"required": ["contains"]}
            ]
          },
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "approved_by": {"type": "string", "minLength": 1},
              "ticket": {"type": "string", "minLength": 1},
              "expires_at": {"type": "string", "minLength": 1}
            }
          }
        },
        "oneOf": [
          {"required": ["evidence"]},
          {"required": ["waiver"]}
        ]
      }
    }
  }
}
