{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ptrgiang/trustforge-skills/contracts/datalease-policy.schema.json",
  "title": "TrustForge DataLease Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "0.1"},
    "purpose": {"type": "string", "minLength": 1},
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "default_action": {
      "type": "string",
      "enum": ["allow", "redact", "deny"],
      "default": "deny"
    },
    "hard_deny_classifiers": {
      "description": "Classifier matches that cannot be overridden by normal rules. Defaults to [\"secret\"].",
      "oneOf": [
        {"type": "string"},
        {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      ]
    },
    "redaction_strategy": {
      "type": "string",
      "enum": ["mask", "null", "last4", "email_domain"],
      "default": "mask"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "paths": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "minItems": 1, "items": {"type": "string"}}
            ]
          },
          "classifiers": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "minItems": 1, "items": {"type": "string"}}
            ]
          },
          "action": {"type": "string", "enum": ["allow", "redact", "deny"]},
          "strategy": {"type": "string", "enum": ["mask", "null", "last4", "email_domain"]},
          "reason": {"type": "string"}
        },
        "required": ["action"],
        "anyOf": [
          {"required": ["paths"]},
          {"required": ["classifiers"]}
        ]
      }
    }
  },
  "required": ["version"],
  "anyOf": [
    {"required": ["purpose"]},
    {"required": ["purposes"]}
  ]
}
