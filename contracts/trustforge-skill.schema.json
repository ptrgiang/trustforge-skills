{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustforge.dev/schemas/skill-contract.schema.json",
  "title": "TrustForge Skill Contract",
  "type": "object",
  "required": ["name", "version", "capabilities", "side_effects", "evidence_required"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "network": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "side_effects": {
      "type": "object",
      "required": ["destructive"],
      "properties": {
        "destructive": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence_required": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
