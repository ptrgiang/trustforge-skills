{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustforge.dev/contracts/commitmentguard-trust-registry.schema.json",
  "title": "TrustForge CommitmentGuard attestation trust registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer", "key_id", "public_key_file"],
        "properties": {
          "issuer": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "public_key_file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
